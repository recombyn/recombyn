{
  "name": "recombyn",
  "version": "0.1.0",
  "private": true,
  "description": "Recombyn — canvas editor + AI Design Agent",
  "license": "Apache-2.0",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/web",
    "apps/collab",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "npm run dev --workspace=apps/web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:stack": "node scripts/dev-stack.mjs",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "dev:desktop:cloud": "node scripts/dev-desktop.mjs cloud",
    "dev:collab": "npm run dev --workspace=apps/collab",
    "build:desktop": "node scripts/dev-desktop.mjs build",
    "build:desktop:cloud": "node scripts/dev-desktop.mjs build cloud",
    "build:desktop:sidecar": "node scripts/dev-desktop.mjs sidecar",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:worker": "node scripts/dev-worker.mjs",
    "gen:contracts": "npm run gen --workspace=@resume-scene/contracts",
    "build": "turbo run build --filter=@resume-scene/web",
    "lint": "turbo run lint",
    "lint:web": "npm run lint --workspace=apps/web",
    "typecheck": "turbo run typecheck --filter=@resume-scene/contracts",
    "check": "turbo run lint --filter=@resume-scene/web && turbo run typecheck --filter=@resume-scene/contracts",
    "ci:gate": "npm run check && npm run test:web && npm run test:api:unit",
    "typecheck:web": "npm run typecheck --workspace=apps/web",
    "test": "npm run test:web && npm run test:api",
    "test:web": "npm run test --workspace=apps/web",
    "test:web:watch": "npm run test:watch --workspace=apps/web",
    "test:web:coverage": "npm run test:coverage --workspace=apps/web",
    "test:api": "node scripts/run-api-tests.mjs",
    "test:api:unit": "node scripts/run-api-tests.mjs tests/unit_tests",
    "test:api:integration": "node scripts/run-api-tests.mjs tests/integration_tests",
    "test:api:coverage": "node scripts/run-api-tests.mjs --cov=app --cov-report=term-missing",
    "test:e2e": "npm run test --prefix e2e",
    "test:canvas:generators": "npm run test --prefix e2e -- tests/canvas.generators.spec.ts",
    "test:canvas:deep": "npm run test --prefix e2e -- tests/canvas.deep.stress.spec.ts",
    "test:canvas:tools": "npm run test --prefix e2e -- tests/canvas.tools.stress.spec.ts",
    "test:canvas:stress": "node scripts/run-canvas-stress.mjs",
    "test:functional:api": "node scripts/functional-api-suite.mjs",
    "test:functional:e2e": "npm run test --prefix e2e -- tests/functional.all.spec.ts",
    "test:functional": "npm run test:functional:api && npm run test:functional:e2e",
    "test:gate": "node scripts/run-quality-gate.mjs --gate=a",
    "test:gate:a": "node scripts/run-quality-gate.mjs --gate=a --skip-agent",
    "test:gate:b": "node scripts/run-quality-gate.mjs --gate=b",
    "test:gate:full": "node scripts/run-quality-gate.mjs --gate=full",
    "ci:mint-token": "node scripts/ci-mint-token.mjs",
    "eval:agent": "node eval/design-agent/run.mjs",
    "perf:k6:smoke": "k6 run perf/k6/smoke.js",
    "perf:k6:api": "k6 run perf/k6/api_crud.js",
    "perf:k6:soak": "k6 run perf/k6/soak.js",
    "perf:k6:collab": "k6 run perf/k6/collab_ws.js",
    "stress:agent": "node scripts/design-agent-stress.mjs",
    "install:api": "cd apps/api && pip install -e \".[dev]\""
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "turbo": "^2.5.4"
  }
}
